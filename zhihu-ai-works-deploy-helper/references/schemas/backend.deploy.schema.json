{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zhihu-ai-works-deploy-helper/backend.deploy.schema.json",
  "title": "TCB backend deploy descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "Runtime", "NodeVersion", "InstallDependencies", "Routes", "Env", "CustomSteps"],
  "properties": {
    "SchemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "Runtime": {"const": "node"},
    "NodeVersion": {"type": "string", "pattern": "^[0-9]+$"},
    "InstallDependencies": {"const": true},
    "Routes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^/"},
      "uniqueItems": true
    },
    "Env": {"const": []},
    "CustomSteps": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Name", "Command"],
        "properties": {
          "Name": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
          "Command": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}
        }
      }
    }
  }
}
