{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcb.deploy/v1alpha1/deploy-plan.schema.json",
  "title": "TCB deploy plan v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "Kind", "Status", "ProjectType", "PackageManager", "Components", "Routes", "Capabilities", "Findings"],
  "properties": {
    "SchemaVersion": {"const": "tcb.deploy/v1alpha1"},
    "Kind": {"const": "deploy-plan"},
    "Status": {"enum": ["ready", "review-required", "blocked"]},
    "ProjectType": {"enum": ["frontend-static", "backend-http", "ssr-node", "fullstack-split", "unsupported"]},
    "PackageManager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Name", "Lockfile"],
      "properties": {
        "Name": {"enum": ["npm", "yarn", "pnpm", "bun", "none", "unknown", "conflict"]},
        "Lockfile": {"type": ["string", "null"]}
      }
    },
    "Components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Unit", "Directory", "Framework", "NodeVersion", "BuildCommand", "BuildRecipe", "BuildArtifacts", "OutputPath", "Entry", "Evidence"],
        "properties": {
          "Unit": {"enum": ["frontend", "backend"]},
          "Directory": {"type": "string"},
          "Framework": {"type": ["string", "null"]},
          "NodeVersion": {"type": ["string", "null"], "pattern": "^(?:[0-9]+)?$"},
          "BuildCommand": {"type": ["string", "null"]},
          "BuildRecipe": {"type": "array", "items": {"$ref": "#/$defs/buildStep"}},
          "BuildArtifacts": {"type": "array", "items": {"$ref": "#/$defs/buildArtifact"}, "uniqueItems": true},
          "BuildValidation": {"$ref": "#/$defs/buildValidation"},
          "OutputPath": {"type": ["string", "null"]},
          "Entry": {"type": ["string", "null"]},
          "DeliveryMode": {"enum": ["static-files", "node-http", "ssr-node"]},
          "RuntimeManifestMode": {"enum": ["root", "overlay"]},
          "RuntimeEntry": {"type": "string", "minLength": 1},
          "RuntimePackagePath": {"type": "string", "minLength": 1},
          "RuntimeLaunch": {"$ref": "#/$defs/runtimeLaunch"},
          "RuntimeResolution": {"$ref": "#/$defs/runtimeResolution"},
          "CloudFunctionRuntime": {"$ref": "#/$defs/cloudFunctionRuntime"},
          "Routes": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true},
          "Evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "allOf": [
          {
            "if": {"properties": {"Unit": {"const": "backend"}}, "required": ["Unit"]},
            "then": {"required": ["CloudFunctionRuntime"]},
            "else": {"not": {"required": ["CloudFunctionRuntime"]}}
          }
        ]
      }
    },
    "Routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BackendPrefixes", "PreservePath"],
      "properties": {
        "BackendPrefixes": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true},
        "PreservePath": {"const": true}
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SSE", "WebSocket"],
      "properties": {"SSE": {"type": "boolean"}, "WebSocket": {"type": "boolean"}}
    },
    "WorkspaceDeps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BuildOrder", "Packages"],
      "properties": {
        "BuildOrder": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Name", "Directory", "BuildCommand"],
            "properties": {
              "Name": {"type": "string"},
              "Directory": {"type": "string"},
              "BuildCommand": {"type": ["string", "null"]}
            }
          }
        },
        "Packages": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        }
      }
    },
    "WorkspaceGraphs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BuildGraph", "RuntimeGraph"],
      "properties": {
        "BuildGraph": {"$ref": "#/$defs/workspaceGraph"},
        "RuntimeGraph": {"$ref": "#/$defs/workspaceGraph"}
      }
    },
    "Findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "cloudFunctionRuntime": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["Runtime", "InstallDependency", "Source"],
      "properties": {
        "Runtime": {"enum": ["Nodejs16.13", "Nodejs18.15", "Nodejs20.19", "Nodejs22.21", "Nodejs24.11"]},
        "InstallDependency": {"type": "boolean"},
        "Source": {"enum": ["auto-map", "reviewed-override"]}
      }
    },
    "buildStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Kind", "Package", "Directory", "DeclaredScript", "Execute", "Source", "Produces"],
      "properties": {
        "Kind": {"enum": ["package-build", "runtime-prepare", "orchestrator"]},
        "Package": {"type": "string", "minLength": 1},
        "Directory": {"type": "string", "minLength": 1},
        "DeclaredScript": {"type": "string", "minLength": 1},
        "Execute": {"type": "string", "minLength": 1},
        "Source": {"type": "string", "minLength": 1},
        "Produces": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "buildArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Role", "Path", "Required", "Source", "Verification"],
      "properties": {
        "Role": {"enum": ["server-runtime", "runtime-assets", "runtime-metadata"]},
        "Path": {"type": "string", "minLength": 1},
        "Required": {"const": true},
        "Source": {"type": "string", "minLength": 1},
        "Verification": {"enum": ["static-evidence", "exists", "fresh", "http-probed"]}
      }
    },
    "buildValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Steps", "Lockfile", "RuntimeEntry", "Artifacts"],
      "properties": {
        "Steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Kind", "Command", "Cwd", "ExitCode", "Result"],
            "properties": {
              "Kind": {"enum": ["install", "build", "start-probe"]},
              "Command": {"type": "string", "minLength": 1},
              "Cwd": {"type": "string", "minLength": 1},
              "ExitCode": {"type": ["integer", "null"]},
              "Result": {"const": "passed"},
              "Host": {"type": "string"},
              "Port": {"type": "integer"},
              "TimeoutSeconds": {"type": "integer"},
              "HttpResponse": {"type": "boolean"}
            }
          }
        },
        "Lockfile": {"type": "string", "minLength": 1},
        "RuntimeEntry": {"type": "string", "minLength": 1},
        "Artifacts": {"type": "array", "items": {"$ref": "#/$defs/buildArtifact"}, "uniqueItems": true}
      }
    },
    "workspaceGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Nodes", "Edges", "Order", "Cyclic"],
      "properties": {
        "Nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "Edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["From", "To"],
            "properties": {"From": {"type": "string"}, "To": {"type": "string"}}
          },
          "uniqueItems": true
        },
        "Order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "Cyclic": {"type": "boolean"},
        "Orchestrator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Command", "Source", "Verification"],
          "properties": {
            "Command": {"type": "string", "minLength": 1},
            "Source": {"type": "string", "minLength": 1},
            "Verification": {"const": "agent-build-verified"}
          }
        }
      }
    },
    "runtimeResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Resolver", "OutputPathSource", "RuntimeEntrySource", "Evidence"],
      "properties": {
        "Resolver": {"type": "string", "minLength": 1},
        "OutputPathSource": {"enum": ["build-config", "framework-config", "framework-fixed", "source-entry", "agent-build-verified", "pending-agent-configuration", "unresolved-dynamic-config"]},
        "RuntimeEntrySource": {"enum": ["explicit", "manifest", "configured", "framework-fixed", "agent-build-verified", "pending-configuration", "unresolved"]},
        "FrameworkContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Id", "Package", "Version", "Match"],
          "properties": {
            "Id": {"type": "string", "minLength": 1},
            "Package": {"type": "string", "minLength": 1},
            "Version": {"type": "string", "minLength": 1},
            "Match": {"enum": ["version-range", "agent-build-verified"]},
            "LaunchKind": {"enum": ["node-entry", "npm-script"]}
          }
        },
        "Evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Fact", "Source", "Value", "Method"],
            "properties": {
              "Fact": {"enum": ["build-command", "output-path", "runtime-entry"]},
              "Source": {"type": "string", "minLength": 1},
              "Value": {"type": "string", "minLength": 1},
              "Method": {"enum": ["explicit", "manifest", "configured", "framework-fixed", "agent-build-verified", "pending-configuration", "unresolved", "source-entry"]}
            }
          }
        }
      }
    },
    "runtimeLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Kind", "Source"],
      "properties": {
        "Kind": {"enum": ["node-entry", "npm-script"]},
        "Entry": {"type": "string", "minLength": 1},
        "Script": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
        "Source": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"Kind": {"const": "node-entry"}}, "required": ["Kind"]},
          "then": {"required": ["Entry"], "not": {"required": ["Script"]}},
          "else": {"required": ["Script"], "not": {"required": ["Entry"]}}
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Code", "Severity", "Unit", "Evidence", "Reason", "Remediation"],
      "properties": {
        "Code": {"type": "string", "pattern": "^[EW]_[A-Z0-9_]+$"},
        "Severity": {"enum": ["error", "warning"]},
        "Unit": {"enum": ["project", "frontend", "backend"]},
        "Evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "Reason": {"type": "string", "minLength": 1},
        "Remediation": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"Severity": {"const": "error"}}, "required": ["Severity"]},
          "then": {"properties": {"Evidence": {"minItems": 1}}}
        }
      ]
    }
  }
}
